// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
}

// 1. 유저 (사용자)
model User {
  id          String   @id @default(uuid()) // 고유 ID
  snsId       String   @unique              // 카카오/구글 로그인 ID 또는 이메일
  provider    String                        // kakao, google, email 등
  nickname    String
  email       String?  @unique              // 이메일 (이메일 로그인 사용자용)
  password    String?                       // 비밀번호 해시 (이메일 로그인 사용자용)
  beats       Int      @default(0)          // 재화 (Beats)
  level       Int      @default(1)
  role        Role     @default(USER)       // USER, ADMIN
  createdAt   DateTime @default(now())

  // 장착 중인 아이템 (User 테이블에 직접 저장하여 조회 속도 향상)
  equippedSkinId    String?
  equippedEffectId  String?

  // 관계 설정 (Relations)
  inventory     Inventory[]      // 내가 가진 아이템들
  hostedRooms   Room[]           // 내가 방장인 방들
  gameResults   GameResult[]     // 내 게임 기록
  songRequests  PlaylistTrack[]  // 내가 신청한 노래들
}

// 2. 상점 아이템
model Item {
  id          String       @id @default(uuid())
  name        String
  category    ItemCategory // SKIN, EFFECT, EMOJI
  price       Int
  imageUrl    String
  description String?

  // 관계 설정
  inventories Inventory[]
}

// 3. 인벤토리 (유저 - 아이템 연결)
model Inventory {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  acquiredAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  item      Item     @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId]) // 같은 아이템 중복 소유 방지
}

// 4. 방 (게임방 + 플리방 통합)
model Room {
  id          String    @id @default(uuid())
  title       String
  password    String?   // 비공개 방일 경우 설정
  isPrivate   Boolean   @default(false)
  
  // 방의 성격
  type        RoomType  // MUSIC_QUIZ, DIALECT_QUIZ, PLAYLIST
  status      RoomStatus @default(WAITING) // WAITING, PLAYING

  // 설정값 (JSON으로 유연하게 저장)
  // 예: { "rounds": 10, "genre": "kpop_2010" }
  options     Json?     

  hostId      String    // 방장 ID
  host        User      @relation(fields: [hostId], references: [id])

  createdAt   DateTime  @default(now())

  // 관계 설정
  playlist    PlaylistTrack[] // 플리방일 경우 신청곡 목록
  gameHistory GameHistory[]   // 이 방에서 진행된 게임 로그
}

// 5. 플레이리스트 신청곡 (플리방 전용)
model PlaylistTrack {
  id          String   @id @default(uuid())
  roomId      String
  userId      String   // 신청자
  
  youtubeUrl  String
  title       String
  duration    Int      // 초 단위
  
  status      TrackStatus @default(WAITING) // WAITING, PLAYING, PLAYED
  orderIndex  Int      // 대기열 순서

  // 방이 삭제되면 신청곡도 함께 삭제
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  requester   User     @relation(fields: [userId], references: [id])
}

// 6. 게임 한 판의 기록 (헤더)
model GameHistory {
  id          String   @id @default(uuid())
  roomId      String
  playedAt    DateTime @default(now())
  
  // 당시 설정 (라운드 수 등) 백업
  gameType    RoomType
  
  // 방이 삭제되면 게임 기록도 함께 삭제
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  results     GameResult[]
}

// 7. 유저별 게임 결과 (상세)
model GameResult {
  id            String      @id @default(uuid())
  gameHistoryId String
  userId        String
  
  rank          Int         // 1위, 2위...
  score         Int         // 획득 점수
  rewardBeats   Int         // 보상으로 받은 비트

  // 게임 헤더가 삭제되면 상세 결과도 함께 삭제
  history       GameHistory @relation(fields: [gameHistoryId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
}

enum ItemCategory {
  SKIN
  EFFECT
  EMOJI
}

enum RoomType {
  MUSIC_QUIZ
  DIALECT_QUIZ
  PLAYLIST
}

enum RoomStatus {
  WAITING
  PLAYING
}

enum TrackStatus {
  WAITING
  PLAYING
  PLAYED
  SKIPPED
}

// 8. 노래 데이터 (게임용)
model Song {
  id          String   @id @default(uuid())
  genre       String   // 발라드, K-pop, J-pop, 팝송, 댄스, 인디, R&B, 힙합
  title       String   // 노래 제목
  artist      String   // 아티스트
  youtubeUrl  String   // YouTube 검색 URL 또는 비디오 ID
  createdAt   DateTime @default(now())

  @@index([genre]) // 장르별 조회 최적화
}